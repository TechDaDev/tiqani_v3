# ===========================================================================
# tiqani_v3 — Production Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ===========================================================================
#   cp .env.production.example .env
# ===========================================================================

# Django settings module (must point to prod)
DJANGO_SETTINGS_MODULE=tiqani_v3.settings.prod

# ── Security (REQUIRED) ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-unique-random-string
DJANGO_SECRET_KEY=change-me-to-a-long-unique-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# ── Database (REQUIRED) ──────────────────────────────────────────────
DATABASE_URL=postgres://tiqani_user:strong_password@db:5432/tiqani_db

# ── CORS / CSRF (REQUIRED) ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ── Email (REQUIRED for transactional emails) ────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=premium86.web-hosting.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=otp@iqtiqani.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=otp@iqtiqani.com
SERVER_EMAIL=otp@iqtiqani.com
EMAIL_PROVIDER=smtp
EMAIL_API_TIMEOUT=10
RESEND_API_KEY=your-resend-api-key

# ── OTP / Registration ──────────────────────────────────────────────
OTP_VALIDITY_SECONDS=600
OTP_MAX_ATTEMPTS=3
REGISTRATION_VERIFICATION_REQUIRED=True

# ── HTTPS / SSL ─────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ── Media Storage (S3-compatible) ────────────────────────────────────
# Set USE_S3_MEDIA=True and USE_S3_STATIC=True to use a bucket for media/static.
USE_S3_MEDIA=False
USE_S3_STATIC=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_STORAGE_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
S3_MEDIA_LOCATION=media
S3_STATIC_LOCATION=static
S3_STATIC_QUERYSTRING_AUTH=True
S3_QUERYSTRING_EXPIRE=900

# Upload size limits (MB)
MAX_PROFILE_IMAGE_SIZE_MB=2
MAX_CATEGORY_ICON_SIZE_MB=1
MAX_DOCUMENT_SIZE_MB=10
MAX_PROOF_FILE_SIZE_MB=5

# ── Celery / Redis ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300

# ── Channels / WebSocket ──────────────────────────────────────────
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/2

# ── Sentry (REQUIRED for error tracking) ──────────────────────────
SENTRY_DSN=https://your-dsn@o123456.ingest.us.sentry.io/1234567
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── App version (injected by CI/CD) ───────────────────────────────
APP_VERSION=1.0.0

# ── API documentation access control ─────────────────────────────
API_DOCS_PUBLIC=False

# ── Optional ────────────────────────────────────────────────────────
SENTRY_DSN=
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
THROTTLE_ANON=10/minute
THROTTLE_USER=60/minute
THROTTLE_LOGIN=5/minute
THROTTLE_PASSWORD_RESET=3/minute
THROTTLE_OTP=3/minute
THROTTLE_ADMIN_WRITE_RATE=30/minute
APP_VERSION=1.0.0
RUN_MIGRATIONS=True
RUN_COLLECTSTATIC=True
SEED_PLATFORM_FEES=True
BACKUP_DIR=/var/backups/tiqani/postgres
RETENTION_DAYS=14
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
