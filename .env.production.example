# ===========================================================================
# tiqani_v3 — Production Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ===========================================================================
#   cp .env.production.example .env
# ===========================================================================

# Django settings module (must point to prod)
DJANGO_SETTINGS_MODULE=tiqani_v3.settings.prod

# ── Security (REQUIRED) ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-unique-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# ── Database (REQUIRED) ──────────────────────────────────────────────
DATABASE_URL=postgres://tiqani_user:strong_password@db:5432/tiqani_db

# ── CORS / CSRF (REQUIRED) ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ── Email (REQUIRED for transactional emails) ────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# ── OTP / Registration ──────────────────────────────────────────────
OTP_VALIDITY_SECONDS=600
OTP_MAX_ATTEMPTS=3
REGISTRATION_VERIFICATION_REQUIRED=True

# ── HTTPS / SSL ─────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ── Media Storage (S3-compatible) ────────────────────────────────────
# Set USE_S3_MEDIA=True and configure your S3-compatible provider.
USE_S3_MEDIA=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_STORAGE_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
S3_QUERYSTRING_EXPIRE=900

# Upload size limits (MB)
MAX_PROFILE_IMAGE_SIZE_MB=2
MAX_CATEGORY_ICON_SIZE_MB=1
MAX_DOCUMENT_SIZE_MB=10
MAX_PROOF_FILE_SIZE_MB=5

# ── Optional ────────────────────────────────────────────────────────
SENTRY_DSN=
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
THROTTLE_ANON=10/minute
THROTTLE_USER=60/minute
APP_VERSION=1.0.0
RUN_MIGRATIONS=True
RUN_COLLECTSTATIC=True
SEED_PLATFORM_FEES=True
