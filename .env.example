# ===========================================================================
# tiqani_v3 — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ===========================================================================
#   cp .env.example .env
# ===========================================================================

# Django settings module (dev or prod)
DJANGO_SETTINGS_MODULE=tiqani_v3.settings.dev

# Security
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP (production):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=premium86.web-hosting.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=noreply@tiqani.com

# OTP / Registration
OTP_VALIDITY_SECONDS=600
OTP_MAX_ATTEMPTS=3
REGISTRATION_VERIFICATION_REQUIRED=True

# Throttle rates (DRF)
# THROTTLE_ANON=10/minute
# THROTTLE_USER=60/minute

# Production-only overrides
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com
SERVER_EMAIL=your-email@example.com

OTP_VALIDITY_SECONDS=600
OTP_MAX_ATTEMPTS=3
REGISTRATION_VERIFICATION_REQUIRED=True

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

THROTTLE_ANON=10/minute
THROTTLE_USER=10/minute
