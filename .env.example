# ===========================================================================
# tiqani_v3 — Development Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ===========================================================================
#   cp .env.example .env
# ===========================================================================

# Django settings module (dev or prod)
DJANGO_SETTINGS_MODULE=tiqani_v3.settings.dev

# ── Security ────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db.sqlite3

# ── CORS / CSRF ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email ───────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@tiqani.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── OTP / Registration ──────────────────────────────────────────────
OTP_VALIDITY_SECONDS=600
OTP_MAX_ATTEMPTS=3
REGISTRATION_VERIFICATION_REQUIRED=True

# ── Throttle rates (DRF) ────────────────────────────────────────────
THROTTLE_ANON=10/minute
THROTTLE_USER=60/minute
THROTTLE_LOGIN=5/minute
THROTTLE_PASSWORD_RESET=3/minute
THROTTLE_OTP=3/minute
THROTTLE_ADMIN_WRITE_RATE=30/minute

# ── Media Storage (S3-compatible) ───────────────────────────────────
# Set USE_S3_MEDIA=True and fill in your S3-compatible provider details.
# Supported: AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO
USE_S3_MEDIA=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_STORAGE_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
# MinIO local example:
# S3_ENDPOINT_URL=http://minio:9000
# S3_STORAGE_BUCKET_NAME=tiqani-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ADDRESSING_STYLE=path

# ── Celery / Redis ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ── Channels / WebSocket ──────────────────────────────────────────
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/2

# ── Sentry (optional — leave blank to disable) ────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=verbose

# ── App version (injected by CI/CD) ───────────────────────────────
APP_VERSION=

# ── Backup/restore helpers ───────────────────────────────────────
BACKUP_DIR=./backups/postgres
RETENTION_DAYS=14

# ── API documentation access control ─────────────────────────────
# Set to False in production to require admin auth for docs
API_DOCS_PUBLIC=True
