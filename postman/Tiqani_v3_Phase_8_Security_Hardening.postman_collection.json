{
  "info": {
    "name": "Tiqani v3 - Phase 8 Security Hardening",
    "description": "## Tiqani v3 - Phase 8\n\n### Security, Permissions Hardening, Audit Rules & API Consistency\n\nSmoke tests for authentication, role-based access, unsafe field protection, and object-level permissions.\n\nTokens are intentionally omitted to verify 401/403 responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "admin_token", "value": "" },
    { "key": "finance_token", "value": "" },
    { "key": "account_manager_token", "value": "" },
    { "key": "normal_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "technician_id", "value": "" },
    { "key": "contract_id", "value": "" },
    { "key": "review_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth Barriers",
      "item": [
        {
          "name": "Dashboard without token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/dashboard/summary/", "host": ["{{base_url}}"], "path": ["api","admin","dashboard","summary"] },
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Wallet /me without token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/wallet/me/", "host": ["{{base_url}}"], "path": ["api","wallet","me"] },
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Contracts without token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/contracts/", "host": ["{{base_url}}"], "path": ["api","contracts"] },
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Notifications without token (expect 401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/notifications/", "host": ["{{base_url}}"], "path": ["api","notifications"] },
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Health (expect 200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/health/", "host": ["{{base_url}}"], "path": ["api","health"] },
            "header": []
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Role-Based Access Control",
      "item": [
        {
          "name": "Finance with wrong role (account_manager) (expect 403)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/finance/summary/", "host": ["{{base_url}}"], "path": ["api","admin","finance","summary"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{account_manager_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Technician approve with finance role (expect 403)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/admin/technicians/{{technician_id}}/approve/", "host": ["{{base_url}}"], "path": ["api","admin","technicians","{{technician_id}}","approve"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{finance_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Review moderation with normal user (expect 403)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/admin/reviews/{{review_id}}/hide/", "host": ["{{base_url}}"], "path": ["api","admin","reviews","{{review_id}}","hide"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{normal_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "Unsafe PATCH Attempts",
      "item": [
        {
          "name": "PATCH account unsafe fields (role/is_staff)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/accounts/me/", "host": ["{{base_url}}"], "path": ["api","accounts","me"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{normal_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"role\": \"admin\", \"is_staff\": true}" }
          }
        },
        {
          "name": "PATCH contract unsafe fields (status change)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/contracts/{{contract_id}}/", "host": ["{{base_url}}"], "path": ["api","contracts","{{contract_id}}"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{normal_token}}" }]
          }
        },
        {
          "name": "PATCH review unsafe fields (via normal user)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/admin/reviews/{{review_id}}/verify/", "host": ["{{base_url}}"], "path": ["api","admin","reviews","{{review_id}}","verify"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{normal_token}}" }]
          }
        }
      ]
    }
  ]
}
